# Bubli frontend production environment
# NEXT_PUBLIC_* values are bundled into the client and must not contain secrets.

NEXT_PUBLIC_API_BASE_URL=https://bubli.n-e.kr
NEXT_PUBLIC_APP_BASE_URL=https://bubli.n-e.kr
NEXT_PUBLIC_WS_URL=wss://bubli.n-e.kr/ws
NEXT_PUBLIC_API_TIMEOUT_MS=15000

NEXT_PUBLIC_BUBLI_PREVIEW_DATA=false
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
NEXT_PUBLIC_TAURI_APP_URL=https://bubli.n-e.kr/app

# UI rollout flags. Keep false unless the production release intentionally enables them.
NEXT_PUBLIC_BUBLI_NEW_DASHBOARD=false
NEXT_PUBLIC_BUBLI_NEW_RESOURCES=false
NEXT_PUBLIC_BUBLI_NEW_WIDGET_PREVIEW=false

# Public download links. Replace with final installer URLs when published.
NEXT_PUBLIC_BUBLI_MACOS_DOWNLOAD_URL=/#download
NEXT_PUBLIC_BUBLI_WINDOWS_DOWNLOAD_URL=/#download
